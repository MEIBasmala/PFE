# ============================================
# KhabirLens Backend Environment Variables
# ============================================

# Core (REQUIRED)
NODE_ENV=production
PORT=5000

# Database — MUST use connection pooling for production
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?connection_limit=5
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?connection_limit=5"

# JWT — MUST be 32+ characters in production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-64-character-hex-secret-here"
JWT_EXPIRES_IN=15m

# Frontend URL — MUST match your deployed frontend exactly (no trailing slash)
CLIENT_URL="https://your-frontend-url.vercel.app"

# Email (REQUIRED — even if fake, vars must exist)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER="your-ethereal-email@ethereal.email"
EMAIL_PASS="your-ethereal-password"

# Stripe (REQUIRED)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudinary (REQUIRED)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AI Services (OPTIONAL — app works without these)
GEMINI_API_KEY=
OLLAMA_URL=
OLLAMA_MODEL=gemma:2b
AI_SERVICE_URL=

# API URL (OPTIONAL)
API_URL=https://your-backend-url.onrender.com