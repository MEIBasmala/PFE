# ============================================
# KhabirLens Backend Environment Variables
# ============================================

# ── Core (REQUIRED) ──────────────────────────
NODE_ENV=production
PORT=5000

# Database (Prisma) — MUST use connection pooling for production
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?connection_limit=5
# Example for Neon: postgresql://user:pass@ep-xxx.neon.tech/dbname?connection_limit=5
# Example for Railway: postgresql://user:pass@containers.railway.app:PORT/dbname?connection_limit=5
DATABASE_URL="postgresql://myuser:pass@localhost:5432/khabirlens?connection_limit=5"

# JWT — MUST be 32+ characters in production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="THEPASSWORDOFJWT"
JWT_EXPIRES_IN=30d

# Frontend URL — MUST match your deployed frontend exactly (no trailing slash)
# Example: https://khabirlens.vercel.app
CLIENT_URL="http://localhost:8081"

# ── Email (REQUIRED — even fake, vars must exist) ──
# Using Ethereal for testing (fake emails, good for dev)
# For production: switch to Gmail, SendGrid, Brevo, etc.
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=broderick.rosenbaum6@ethereal.email
EMAIL_PASS=NWptSXwbckzCQWFAJh

# ── Stripe (REQUIRED) ─────────────────────────
# ⚠️  NEVER expose STRIPE_SECRET_KEY to frontend
# Use TEST keys for development, LIVE keys only in production
